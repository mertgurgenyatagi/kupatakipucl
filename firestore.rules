rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Profiles: name + photo are shown to signed-out visitors too (SPEC §8's
    // logged-out player list) as well as other participants (SPEC §8/§4), so
    // read is public. Only the owner can write their own.
    match /profiles/{uid} {
      allow read: if true;
      // Field validation added 2026-07-29 (not-started-audit item 04/15):
      // name length caps mirror NameStep.tsx's 15-char client-side cap.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.firstName is string
        && request.resource.data.firstName.size() > 0
        && request.resource.data.firstName.size() <= 15
        && request.resource.data.lastName is string
        && request.resource.data.lastName.size() > 0
        && request.resource.data.lastName.size() <= 15
        && request.resource.data.photoURL is string;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Survey responses: readable by any signed-in participant (reversed
    // 2026-07-23 from owner-only — the participant popup's quiz-answers
    // widget shows other participants' answers directly, Mert's explicit
    // call, overriding SPEC.md §4/§8d's earlier "aggregate-only" stance; see
    // SPEC.md's changelog for the reversal). Still owner-only to create, and
    // one-time-only (SPEC §5) — no updates or deletes once created.
    match /surveyResponses/{uid} {
      allow read: if request.auth != null;
      // Field validation added 2026-07-29 (not-started-audit item 04) —
      // shape/range matches SignupFlow.tsx's quiz options exactly.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.age is number
        && request.resource.data.age >= 1
        && request.resource.data.age <= 120
        && request.resource.data.footballKnowledge is number
        && request.resource.data.footballKnowledge >= 1
        && request.resource.data.footballKnowledge <= 7
        && request.resource.data.messiOrRonaldo in ['messi', 'ronaldo', 'no-opinion']
        && request.resource.data.superLigTeam is string
        && request.resource.data.device in ['phone', 'desktop', 'both'];
      allow update, delete: if false;
    }

    // Predictions: read is public (matches the "trust the friend group"
    // stance already applied to chat/forum in SPEC §6, and SPEC §8's
    // requirement that predictions become visible to signed-out visitors
    // too once the tournament starts — the app UI hides others' predictions
    // until then; this project has no adversarial threat model). Only the
    // owner writes.
    match /predictions/{uid} {
      allow read: if true;
      // Field validation added 2026-07-29 (not-started-audit item 04): a
      // prediction is always a full 36-team ranking, never partial.
      allow create, update: if request.auth != null
        && request.auth.uid == uid
        && request.resource.data.ranking is list
        && request.resource.data.ranking.size() == 36;
      allow delete: if request.auth != null && request.auth.uid == uid;
    }

    // Team results feed the team table and score computation (SPEC.md §3, §8b),
    // shown to signed-out visitors too (SPEC §8's logged-out live rankings).
    // No admin UI (SPEC.md §7b) — normally maintained via direct Firestore
    // edits. Temporarily opened to any signed-in write pre-launch so the dev
    // panel (src/devpanel) can push synthetic standings from the browser;
    // tighten back to `if false` once results automation/admin tooling lands.
    match /results/{teamId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Tournament phase (src/tournament/useTournamentPhase.ts): the single
    // manual admin-set value driving notstarted/leaguephase/preknockout/
    // knockout site-wide (SPEC decision 2026-07-23 — pagemap intake round 1).
    // Public read (even logged-out visitors need to know the phase to decide
    // what to show). No admin UI (SPEC.md §7b, same stance as `results`) —
    // set directly via the Firebase console. Write left open to any signed-in
    // user for now, same trust-the-friend-group convention as `results`.
    match /tournamentState/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // Dev-only tooling (src/devpanel): simulates tournament phase/date and
    // match outcomes so timing-dependent features can be tested without
    // waiting on real calendar dates. Pre-launch, no real users yet — same
    // trust stance as the rest of this file. Remove once results automation
    // (SPEC.md §7, currently skipped) makes this panel unnecessary.
    match /devConfig/{docId} {
      allow read, write: if request.auth != null;
    }
    match /devMatches/{fixtureId} {
      allow read, write: if request.auth != null;
    }

    // Chat messages: logged-in only (matches the "chat" page's own gate in
    // pageAccess.ts — SPEC.md §8 shows no chatroom to logged-out visitors in
    // either state, unlike profiles/predictions/results). A user can only
    // create a message attributed to their own uid. No admin panel (SPEC.md
    // §7b) — still nobody can touch anyone else's message.
    //
    // Self-delete is the one exception (chat-widget-round-01 Q16), reversing
    // SPEC.md §6's original "permanent scrollback... no edits or deletes,
    // ever, by anyone": the sender can flip their own message's `deleted`
    // flag (and only that field — no editing text, per Q15's "no"), which
    // ChatRoom.tsx renders as a placeholder rather than actually erasing the
    // doc. Still no update path for anyone else's message, and still no
    // delete of the doc itself by anyone, sender included.
    match /messages/{messageId} {
      allow read: if request.auth != null;
      // Field validation added 2026-07-29 (not-started-audit item 04):
      // mirrors ChatComposer.tsx's 360-char cap (messageTypes.ts), enforced
      // here since the client-side maxlength is trivially bypassable.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 360;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
        && request.resource.data.deleted == true;
      allow delete: if false;
    }

    // Typing indicator: ephemeral per-user "I'm typing" signal for the Home
    // chat widget (chat-widget-round-01 Q5). Doc id is the uid, so there's
    // at most one per person. Short-lived by client convention — anything
    // more than a few seconds old is treated as stale by useTypingStatus.ts
    // — rather than a TTL delete, so no extra write path is needed here.
    match /typingStatus/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Presence: a periodic per-user heartbeat backing the chat widget's "N
    // çevrimiçi" count (chat-widget-round-01 Q7). Same staleness convention
    // as typingStatus above — this project runs on Firestore, not Realtime
    // Database, so there's no server-side onDisconnect hook to lean on
    // instead.
    match /presence/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    // Forum posts: public read (pageAccess.ts allows the logged-out ST_NLI
    // state to view the forum — unlike chat, which is logged-in only in
    // every state). A user can only create a post attributed to their own
    // uid.
    //
    // Editing (forum-round-02/03) is text/mentions/editedAt only — never
    // imageURL, parentId, uid, createdAt, or the quote fields, so a reply's
    // quote can't be forged after the fact.
    //
    // Deleting is real, with cascade (forum-round-01/03): you can delete
    // your own post, OR any reply whose root post you own — that second
    // branch is what makes "delete my thread" work at all, since the batch
    // in deletePost.ts deletes replies authored by other people too. A
    // reply's own parentId always points at a root post it was created
    // against (replies are flat — forum-round-01 Q3 — so this never chains
    // more than one hop deep).
    match /forumPosts/{postId} {
      allow read: if true;
      // Field validation added 2026-07-29 (not-started-audit item 04/10):
      // text is capped at 360 to match chat (an empty string is only valid
      // when an image carries the post instead, per createPost.ts). Quote
      // integrity (item 05): a quote naming a real postId must actually
      // point at an existing post, and the claimed quotedAuthorUid must
      // match that post's real author — otherwise words could be put in
      // someone's mouth they never posted. Not validated against the
      // quoted post's *current* text, since an edit made after being quoted
      // is expected to diverge from the cached snapshot (that's the whole
      // point of caching it) — only existence + true authorship are checked.
      allow create: if request.auth != null
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() <= 360
        && (request.resource.data.text.size() > 0 || request.resource.data.imageURL != null)
        && request.resource.data.likedByUids == []
        && (
          request.resource.data.quotedPostId == null
          || (
            exists(/databases/$(database)/documents/forumPosts/$(request.resource.data.quotedPostId))
            && get(/databases/$(database)/documents/forumPosts/$(request.resource.data.quotedPostId)).data.uid == request.resource.data.quotedAuthorUid
          )
        );
      // Two shapes: the author editing text/mentions/editedAt (unchanged),
      // or ANY signed-in user toggling their own uid in or out of
      // likedByUids (forum-widget-round-01's like feature, moved off its
      // own `postLikes` collection onto the post doc itself — scaling-audit
      // No. 10, 2026-07-31). The like branch checks the symmetric
      // difference is exactly the caller's own uid, so nobody can add or
      // remove someone else's like while they're at it.
      allow update: if request.auth != null && (
        (
          resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['text', 'mentionedUids', 'editedAt'])
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 360
          && (request.resource.data.text.size() > 0 || resource.data.imageURL != null)
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['likedByUids'])
          && request.resource.data.likedByUids is list
          && (
            request.resource.data.likedByUids.toSet().difference(resource.data.likedByUids.toSet()).hasOnly([request.auth.uid])
            || resource.data.likedByUids.toSet().difference(request.resource.data.likedByUids.toSet()).hasOnly([request.auth.uid])
          )
        )
      );
      allow delete: if request.auth != null
        && (resource.data.uid == request.auth.uid
            || (resource.data.parentId != null
                && get(/databases/$(database)/documents/forumPosts/$(resource.data.parentId)).data.uid == request.auth.uid));
    }

    // Special Lobby: private friend-group sub-scopes. Membership is a
    // subcollection (not an array field) specifically so joining can be
    // verified against a real invite via exists()/get() — see design doc
    // docs/superpowers/specs/2026-07-29-special-lobby-design.md.
    //
    // `memberUids` denormalizes that subcollection's uids onto the lobby doc
    // itself (2026-07-31, scaling-audit No. 07) purely so the read rule
    // below can check membership on the doc it's already reading, instead
    // of paying a second exists() read on the members subcollection for
    // every single fetch — including every snapshot useMyLobbies' live
    // listener delivers, which was silently doubling that read cost. The
    // members subcollection stays the real source of truth for who's
    // actually a member (and is what the update rule's membership-sync
    // branch below defers to); memberUids is kept in step with it on every
    // join/leave/removal (joinLobbyViaInvite.ts, leaveLobby.ts,
    // removeMember.ts) but is never itself the thing that authorizes one.
    match /lobbies/{lobbyId} {
      allow read: if request.auth != null && resource.data.memberUids.hasAny([request.auth.uid]);
      allow create: if request.auth != null
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 15
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.memberUids == [request.auth.uid];
      // Three shapes: a rename (any current member), an ownership transfer
      // (only the departing creator, only to an existing member — see
      // leaveLobby.ts's ownership-transfer branch), or a memberUids sync.
      // The sync branch doesn't re-derive who's allowed to join/leave/be
      // removed — the members subcollection's own create/delete rules
      // already fully authorize that — it only checks that this change is
      // consistent with a real membership change in the very same request:
      // exactly one uid gained, and it's the caller gaining their own
      // membership; exactly one uid lost, and it's either the caller
      // leaving or the creator removing someone.
      allow update: if request.auth != null && (
        (
          exists(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(request.auth.uid))
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name'])
          && request.resource.data.name is string
          && request.resource.data.name.size() > 0
          && request.resource.data.name.size() <= 15
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['createdByUid'])
          && resource.data.createdByUid == request.auth.uid
          && exists(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(request.resource.data.createdByUid))
        ) || (
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
          && request.resource.data.memberUids is list
          && (
            (
              request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).hasOnly([request.auth.uid])
              && resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).size() == 0
              && existsAfter(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(request.auth.uid))
            ) || (
              resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).hasOnly([request.auth.uid])
              && request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).size() == 0
              && !existsAfter(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(request.auth.uid))
            ) || (
              resource.data.createdByUid == request.auth.uid
              && request.resource.data.memberUids.toSet().difference(resource.data.memberUids.toSet()).size() == 0
              && resource.data.memberUids.toSet().difference(request.resource.data.memberUids.toSet()).size() == 1
            )
          )
        )
      );
      allow delete: if request.auth != null && resource.data.createdByUid == request.auth.uid;
    }

    match /lobbies/{lobbyId}/members/{uid} {
      // A user may always read their own (possibly not-yet-existing) member
      // doc path, in addition to the normal membership-gated read below —
      // this lets joinLobbyViaInvite.ts's already-member getDoc() succeed
      // for a genuine first-time joiner (who has no member doc yet, so the
      // exists() branch alone would deny them) without exposing any other
      // user's membership data (2026-07-30, task-13 fix).
      allow read: if request.auth != null
        && (
          request.auth.uid == uid
          || exists(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(request.auth.uid))
        );
      // Two shapes: the creator's own bootstrap membership (no invite exists
      // yet at lobby-creation time), or a normal invite-gated join.
      allow create: if request.auth != null
        && request.auth.uid == uid
        && (
          (
            request.resource.data.viaInviteId == null
            // getAfter() (not get()): createLobby.ts writes the lobby doc,
            // this bootstrap member doc, and the "created" message all in
            // one writeBatch, so the lobby doc doesn't exist yet from a
            // plain get()'s pre-batch point of view. getAfter() sees the
            // batch's own pending state, i.e. the lobby doc as it will be
            // once this batch commits (2026-07-30, task-13 fix).
            && getAfter(/databases/$(database)/documents/lobbies/$(lobbyId)).data.createdByUid == request.auth.uid
          ) || (
            request.resource.data.viaInviteId is string
            && get(/databases/$(database)/documents/lobbyInvites/$(request.resource.data.viaInviteId)).data.lobbyId == lobbyId
            && get(/databases/$(database)/documents/lobbyInvites/$(request.resource.data.viaInviteId)).data.expiresAt > request.time.toMillis()
          )
        );
      // Self-removal (leaving) or creator-removes-someone-else — also used
      // by deleteLobby.ts to clear every member doc when the whole lobby goes.
      allow delete: if request.auth != null
        && (
          request.auth.uid == uid
          || get(/databases/$(database)/documents/lobbies/$(lobbyId)).data.createdByUid == request.auth.uid
        );
    }

    // Collection-group read over every `members` subcollection, which is
    // what useMyLobbies.ts's
    // `query(collectionGroup(db, "members"), where("uid", "==", uid))`
    // actually issues. The path-scoped rule above does NOT cover this:
    // Firestore only applies `match /lobbies/{lobbyId}/members/{uid}` to
    // direct reads of that literal path, never to a collection-group query,
    // which needs a recursive-wildcard match to be authorized at all. This
    // is purely additive — the block above still serves every direct
    // subcollection read (2026-07-30, final-review fix).
    //
    // Gated on `resource.data.uid`, not the `{memberUid}` path segment, on
    // purpose: a collection-group query is only allowed if EVERY document it
    // could return satisfies the rule, so the constraint has to be one the
    // query itself declares. The query's own where("uid","==",uid) is what
    // makes that true — a query without it (i.e. someone trying to list all
    // memberships everywhere) is rejected outright.
    match /{path=**}/members/{memberUid} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
    }

    match /lobbyInvites/{inviteId} {
      // `get` (fetch one invite by its known id) is open to any signed-in
      // user — a not-yet-member needs to resolve the token before they have
      // any membership doc to gate on. `list` is NOT: `allow read` would
      // cover both, letting anyone enumerate every live invite across every
      // lobby and join at will, which defeats invite-only entirely
      // (2026-07-30, final-review fix). joinLobbyViaInvite.ts only ever does
      // a getDoc() by known id here, never a query, so blocking list costs
      // the app nothing.
      allow get: if request.auth != null;
      allow list: if false;
      allow create: if request.auth != null
        && exists(/databases/$(database)/documents/lobbies/$(request.resource.data.lobbyId)/members/$(request.auth.uid))
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.expiresAt == request.resource.data.createdAt + 3600000;
      allow update, delete: if false;
    }

    match /lobbies/{lobbyId}/messages/{messageId} {
      allow read: if request.auth != null
        && exists(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(request.auth.uid));
      // existsAfter() (not exists()): createLobby.ts's "created" system
      // message is batched with the lobby doc and the creator's bootstrap
      // member doc in one writeBatch, so plain exists() (pre-batch state)
      // can't see the sibling member-doc write. existsAfter() sees it as it
      // will exist once the batch commits (2026-07-30, task-13 fix).
      allow create: if request.auth != null
        && existsAfter(/databases/$(database)/documents/lobbies/$(lobbyId)/members/$(request.auth.uid))
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.text is string
        && request.resource.data.text.size() > 0
        && request.resource.data.text.size() <= 360;
      allow update: if request.auth != null
        && resource.data.uid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['deleted'])
        && request.resource.data.deleted == true;
      allow delete: if false;
    }
  }
}
