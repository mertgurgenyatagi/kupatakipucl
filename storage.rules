rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {
    // Profile photos are public within the app (shown to other participants),
    // so any signed-in user can read. Only the owner can upload their own,
    // capped at 5MB and restricted to image files.
    //
    // Filename is `{uid}-{timestamp}`, not a fixed `{uid}` (2026-07-31) — a
    // fresh, never-reused path per upload so the immutable Cache-Control set
    // on upload is always safe (a cached copy at a given URL is never stale,
    // it's either the current photo or an orphan nobody links to). That
    // means the uid check has to pull the owner out of the filename's own
    // prefix instead of matching the whole path segment.
    //
    // `create` and `delete` are split (rather than one combined `write`)
    // because `request.resource` is null on a delete — a rule that
    // references `request.resource.size` there errors out and denies the
    // delete outright, silently breaking both account-deletion's cleanup
    // and a photo-change's cleanup of the photo it's replacing.
    match /profile-photos/{fileName} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
                    && fileName.split('-')[0] == request.auth.uid
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null
                    && fileName.split('-')[0] == request.auth.uid;
    }

    // Forum post images: public read (matches forum posts' own public
    // visibility). Any signed-in user can upload, capped at 5MB, restricted
    // to PNG/JPEG/WebP (SPEC.md §6: "image uploads only, no video/gif" —
    // an explicit allowlist is simpler than expressing "any image except
    // gif" as a rule condition). Filename is `{uid}-{timestamp}`, same
    // reasoning and the same create/delete split as profile-photos above —
    // only the uploader can delete their own forum image.
    match /forum-images/{fileName} {
      allow read: if true;
      allow create: if request.auth != null
                    && request.resource.size < 5 * 1024 * 1024
                    && request.resource.contentType in ['image/png', 'image/jpeg', 'image/webp'];
      allow delete: if request.auth != null
                    && fileName.split('-')[0] == request.auth.uid;
    }
  }
}
